from vex import *

# Begin project code
myVariable = 0  # Global variable (unused in logic shown)
message1 = Event()  # Event placeholder (not triggered in shown code)

# Function: Moves robot forward if an object is detected in front
def forward():
    global myVariable, message1
    wait(0.1, SECONDS)
    while True:
        if distance_9.is_object_detected():  # Uses front distance sensor
            drivetrain.stop()  # Stop movement when object is detected
            wait(0.1, SECONDS)
            drivetrain.drive_for(FORWARD, 24, INCHES)  # Drive forward 24 inches
        wait(5, MSEC)

# Function: Oscillates robot left and right continuously
def twist():
    global myVariable, message1
    drivetrain.set_drive_velocity(100, PERCENT)  # Set drive speed
    drivetrain.set_turn_velocity(200, RPM)       # Set turn speed
    while True:
        drivetrain.turn_for(RIGHT, 95, DEGREES)   # Turn right slightly more than 90 degrees
        drivetrain.turn_for(LEFT, 95, DEGREES)    # Then turn left the same amount
        wait(5, MSEC)

# Function: Turns robot right if object is detected by right sensor
def turn_right():
    global myVariable, message1
    while True:
        if distance_20.is_object_detected():  # Uses right-facing distance sensor
            drivetrain.turn_for(RIGHT, 90, DEGREES)  # Turn right 90 degrees
        wait(5, MSEC)

# Function: Turns robot around (180°) if object is detected at the back
def turn_around():
    global myVariable, message1
    while True:
        if distance_8.is_object_detected():  # Uses rear-facing distance sensor
            drivetrain.turn_for(RIGHT, 180, DEGREES)  # Turn completely around
        wait(5, MSEC)

# Function: Turns robot left if object is detected by left sensor
def turn_left():
    global myVariable, message1
    while True:
        if distance_10.is_object_detected():  # Uses left-facing distance sensor
            drivetrain.turn_for(LEFT, 90, DEGREES)  # Turn left 90 degrees
        wait(5, MSEC)

# Another global event and variable setup
myVariable = 0
flipbot = Event()

# Function: Controls a motor group to "flip" an object if one is close in front
def flip():
    global myVariable, flipbot
    motor_group_7.set_max_torque(300, PERCENT)  # Set high torque for strong movement
    while True:
        if distance_9.object_distance(MM) < 300:  # Check if object is within 300 mm
            motor_group_7.spin_for(FORWARD, 180, DEGREES)   # Flip forward
            motor_group_7.spin_for(REVERSE, 180, DEGREES)   # Flip back
            motor_group_7.stop()  # Stop motor after action
        wait(5, MSEC)

# Launch various behaviors as background threads
ws2 = Thread(twist)         # Oscillating motion
ws3 = Thread(turn_right)    # Right sensor logic
ws4 = Thread(turn_around)   # Rear sensor logic
ws5 = Thread(turn_left)     # Left sensor logic
ws6 = Thread(flip)          # Flip object if close

# Start the main forward movement function (runs in the main thread)
forward()
