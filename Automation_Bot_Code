# Library imports
from vex import *

# Begin project code
myVariable = 0
message1 = Event()

# Function: Moves robot forward if an object is detected in front
def forward():
    global myVariable, message1
    wait(0.1, SECONDS)
    while True:
        if distance_9.is_object_detected():
            drivetrain.stop()
            wait(0.1, SECONDS)
            drivetrain.drive_for(FORWARD, 24, INCHES)
        wait(5, MSEC)

# Function: Oscillates robot left and right continuously
def twist():
    global myVariable, message1
    drivetrain.set_drive_velocity(100, PERCENT)
    drivetrain.set_turn_velocity(200, RPM)
    while True:
        drivetrain.turn_for(RIGHT, 95, DEGREES)
        drivetrain.turn_for(LEFT, 95, DEGREES)
        wait(5, MSEC)

# Function: Turns robot right if object is detected by right sensor
def turn_right():
    global myVariable, message1
    while True:
        if distance_20.is_object_detected():
            drivetrain.turn_for(RIGHT, 90, DEGREES)
        wait(5, MSEC)

# Function: Turns robot around if object is detected at the back
def turn_around():
    global myVariable, message1
    while True:
        if distance_8.is_object_detected():
            drivetrain.turn_for(RIGHT, 180, DEGREES)
        wait(5, MSEC)

# Function: Turns robot left if object is detected by left sensor
def turn_left():
    global myVariable, message1
    while True:
        if distance_10.is_object_detected():
            drivetrain.turn_for(LEFT, 90, DEGREES)
        wait(5, MSEC)

# Function: Flips an object if it is within 300 mm of the front sensor
def flip():
    global myVariable, flipbot
    motor_group_7.set_max_torque(300, PERCENT)
    while True:
        if distance_9.object_distance(MM) < 300:
            motor_group_7.spin_for(FORWARD, 180, DEGREES)
            motor_group_7.spin_for(REVERSE, 180, DEGREES)
            motor_group_7.stop()
        wait(5, MSEC)

# NEW FUNCTION: Uses line sensor to detect dark line and turn around
def avoid_line():
    while True:
        # If the reflectivity drops below 30, we assume it's over a line
        if line_sensor.reflectivity() < 30:
            drivetrain.turn_for(RIGHT, 180, DEGREES)
        wait(5, MSEC)

# Launch concurrent behavior threads
ws2 = Thread(twist)
ws3 = Thread(turn_right)
ws4 = Thread(turn_around)
ws5 = Thread(turn_left)
ws6 = Thread(flip)
ws7 = Thread(avoid_line)  # NEW: Run the line-avoidance behavior

# Start main driving loop
forward()
